<Window x:Class="MguSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGU Setup" Width="1050" Height="800" MinWidth="860" MinHeight="690"
        Background="#171A1F" Foreground="#EDF0F3" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#E8AD4B"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#242B34"/>
            <Setter Property="BorderBrush" Value="#333C47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8C3D0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20262E"/>
            <Setter Property="Foreground" Value="#EDF0F3"/>
            <Setter Property="BorderBrush" Value="#56616F"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303741"/>
            <Setter Property="Foreground" Value="#EDF0F3"/>
            <Setter Property="BorderBrush" Value="#56616F"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#171A1F"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#111418" BorderBrush="#333940" BorderThickness="0,0,1,0">
            <StackPanel Margin="18,25">
                <TextBlock Text="MGU Setup" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="WORKSHOP" Foreground="{StaticResource Accent}" FontSize="12"
                           FontWeight="SemiBold" Margin="0,7,0,24"/>
                <Border Background="#302A20" CornerRadius="5" Padding="12,10">
                    <TextBlock Text="Head unit setup" Foreground="#F3C573" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="BMW iDrive 7 / 8" Style="{StaticResource Note}" Margin="12,14,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="22,18">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Head unit setup" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Connect over ENET, set up root SSH, and install MGU Store."
                           Style="{StaticResource Note}" Margin="0,3,0,13"/>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="01  Connection" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <Label Content="_Gateway address (optional)" Target="{Binding ElementName=GatewayAddress}"
                                       Foreground="#EDF0F3" Padding="0,0,0,4"/>
                                <TextBox x:Name="GatewayAddress" ToolTip="Leave blank for automatic ENET discovery."/>
                            </StackPanel>
                            <Button x:Name="CheckButton" Grid.Column="1" VerticalAlignment="Bottom"
                                    Content="Check ENET status" Click="CheckStatus"/>
                        </Grid>
                        <TextBlock x:Name="FolderLabel" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="02  Root SSH" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Variant" Width="205" HorizontalAlignment="Left"
                                      Padding="7,5" AutomationProperties.Name="Head unit variant"
                                      SelectionChanged="UpdateSshAvailability">
                                <ComboBoxItem Content="Select head unit variant" IsEnabled="False"/>
                                <ComboBoxItem Content="iDrive 7" Tag="id7"/>
                                <ComboBoxItem Content="iDrive 8 BDC3" Tag="id8-bdc3"/>
                                <ComboBoxItem Content="iDrive 8 BCP" Tag="id8-bcp"/>
                            </ComboBox>
                            <Button x:Name="SshButton" Grid.Column="1" Content="Set up root SSH…"
                                    IsEnabled="False" Click="InstallSsh"/>
                        </Grid>
                        <Border Background="#302A20" BorderBrush="#67502E" BorderThickness="1"
                                CornerRadius="5" Padding="10,8" Margin="0,9,0,0">
                            <CheckBox x:Name="AcceptRisk" Foreground="#F3C573" VerticalContentAlignment="Center"
                                      Checked="UpdateSshAvailability" Unchecked="UpdateSshAvailability">
                                <TextBlock TextWrapping="Wrap"
                                           Text="I understand that flashing clears coding and Digital Key pairings. Without a coding backup, I may lose settings or head unit functions and be unable to recover them."/>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="03  MGU Store" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Requires root SSH and working vehicle coding. Restarts the head unit if needed."
                                       Style="{StaticResource Note}"/>
                        </StackPanel>
                        <Button x:Name="StoreButton" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButton}" Content="Install MGU Store…" Click="InstallStore"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="State" Text="Ready." Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"/>
            </StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Session log" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                         FontSize="12" Background="#111418" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Session log"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
